# /api is proxied locally. Separate hosted services require an HTTPS URL ending in /api.
VITE_API_BASE_URL=/api
# Optional paired PUBLIC values enable sign-in. pnpm dev:configure supplies local values.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-project-public-key
# Never put service-role, database, or provider credentials in VITE_ variables.
