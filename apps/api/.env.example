# Public transport works without Supabase. For synthetic account setup run pnpm dev:configure.
NODE_ENV=development
KINETRA_ENV=development
PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
# Preview/production require separate Supabase project values and an HTTPS web origin.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-project-publishable-key
# SERVER ONLY: never prefix this with VITE_ or expose it in browser code.
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Hourly conservative reservation limits; no provider routes are enabled yet.
AI_REQUEST_LIMIT=5
AI_GLOBAL_REQUEST_LIMIT=100
AI_TOKEN_LIMIT=50000
AI_GLOBAL_TOKEN_LIMIT=1000000
AI_MAX_CONCURRENT=1
AI_RESERVED_TOKENS=1000
