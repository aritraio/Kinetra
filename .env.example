# ==============================================================================
# KINETRA MONOREPO ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to:
#   - apps/api/.env  (for backend services)
#   - apps/web/.env  (for frontend client)
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit actual .env or credentials to version control.
# 2. NEVER prefix backend secrets (like SUPABASE_SERVICE_ROLE_KEY or AI API keys)
#    with VITE_, which would bake them into public client-side browser bundles.
# 3. For local zero-setup development, running `pnpm dev:configure` automatically
#    provisions local synthetic values for local Supabase and development proxy.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API SERVER CONFIGURATION (apps/api/.env)
# ------------------------------------------------------------------------------
NODE_ENV=development
KINETRA_ENV=development
PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173

# Database & Supabase Auth Configuration (Server-Side)
# For local development with Supabase CLI (`pnpm db:start`):
# Run `pnpm dev:configure` to automatically sync local keys.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_synthetic_key
# SERVER ONLY: Must NEVER be exposed to frontend code or client bundles.
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_synthetic_key

# Upstream AI Provider Keys (Server-Side Only)
# If omitted or unavailable, Kinetra operates in deterministic fallback mode
# using evaluated semantic verification and vetted templates.
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-fallback-api-key-here

# Conservative Operational AI Budgets & Rate Limiting (Hourly Buckets)
AI_REQUEST_LIMIT=5
AI_GLOBAL_REQUEST_LIMIT=100
AI_TOKEN_LIMIT=50000
AI_GLOBAL_TOKEN_LIMIT=1000000
AI_MAX_CONCURRENT=1
AI_RESERVED_TOKENS=1000

# ------------------------------------------------------------------------------
# 2. WEB CLIENT CONFIGURATION (apps/web/.env)
# ------------------------------------------------------------------------------
# API Base Endpoint (In dev, Vite proxies /api to http://127.0.0.1:3001)
VITE_API_BASE_URL=/api

# Public Supabase Client Settings (Browser-Safe Anonymous Keys Only)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_synthetic_key
