{
  "name": "kinetra",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @kinetra/api --filter @kinetra/web dev",
    "lint": "biome lint . && node --import tsx scripts/check-boundaries.ts",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm -r build && node --import tsx scripts/scan-web.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:migrate": "supabase migration up --local",
    "db:reset": "supabase db reset --local",
    "db:seed": "node --import tsx scripts/seed-auth.ts",
    "test:db": "supabase test db",
    "smoke": "node --import tsx scripts/smoke.ts",
    "dev:configure": "node --import tsx scripts/configure-local.ts",
    "test:security": "node --import tsx scripts/security-integration.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.0",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vitest": "5.0.3",
    "esbuild": "0.28.2",
    "supabase": "2.119.0",
    "@trpc/client": "11.19.0",
    "zod": "4.6.5"
  }
}
